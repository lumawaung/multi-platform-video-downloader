BOT_TOKEN=your_telegram_bot_token_here

# Optional: name shown in the welcome message (default: Video Downloader)
BOT_NAME=

# From https://my.telegram.org — used for the MTProto uploader account
# (setup_session.py asks for these and fills them in if left empty)
API_ID=
API_HASH=

# Private relay channel ID (e.g. -1001234567890)
# Both the bot AND the user account must be admins of this channel
# (setup_session.py lists your channels and fills this in)
RELAY_CHANNEL_ID=

# Optional: cookies.txt exported from a logged-in browser (Netscape format)
# Unlocks age-restricted videos. Leave empty to download without cookies.
COOKIES_FILE=

# Optional: YouTube PO token provider (see README). Leave empty if not running one.
POT_PROVIDER_URL=

# Optional: your Telegram user ID(s), comma-separated — exempt from per-user limits
ADMIN_IDS=

# Optional: premium custom emoji (see emojis.py)
# DISABLE_CUSTOM_EMOJI=true sends plain emoji everywhere
DISABLE_CUSTOM_EMOJI=false
# Override or add one emoji ID without editing code, e.g.:
# CUSTOM_EMOJI_VIDEO=5368324170671202286

# Optional: cap download speed (bytes per second, e.g. 5M or 800K); empty = unlimited
DOWNLOAD_RATE_LIMIT=

# Optional: send sites that block the server's country through a proxy, e.g. an
# SSH tunnel to a server elsewhere (see README, "Sites blocked in the server's country").
# PROXY_SITES: yt-dlp site names, comma-separated, matched by prefix ("pornhub" also
# covers PornHubUser). Every other site connects directly.
PROXY_URL=
PROXY_SITES=

# Optional: server capacity and per-user limits (defaults in config.py)
# MAX_CONCURRENT_DOWNLOADS=3
# MAX_CONCURRENT_UPLOADS=3
# INFO_WORKERS=4
# USER_MAX_ACTIVE_DOWNLOADS=1
# USER_DOWNLOADS_PER_HOUR=20
# USER_LOOKUPS_PER_HOUR=60
